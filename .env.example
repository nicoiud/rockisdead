# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (publishable / anon)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (secret / service_role). NUNCA exponer en el cliente.
SUPABASE_SECRET_KEY=

# URL pública del sitio (links de emails, retorno de Mercado Pago, webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mercado Pago (opcional: también se configuran desde Admin > Configuración) ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# true = usar sandbox_init_point (credenciales de prueba)
MP_SANDBOX=false

# --- Emails (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Rock Is Dead <pedidos@tudominio.com>"

# --- Cron del reporte semanal (Vercel lo envía como Bearer) ---
CRON_SECRET=
