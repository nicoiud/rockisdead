# Copiar a `.env` en la VM (deploy/.env) y completar. No se sube a git.

# --- Imagen a correr (la arma GitHub Actions) ---
APP_IMAGE=ghcr.io/TU_USUARIO/rockisdead:latest

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=https://tudominio.com

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=false

# --- Emails (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Rock Is Dead <pedidos@tudominio.com>"

# --- Cron del reporte semanal ---
CRON_SECRET=
